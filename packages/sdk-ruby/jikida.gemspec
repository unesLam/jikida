Gem::Specification.new do |s|
  s.name        = "jikida"
  s.version     = "0.1.0"
  s.summary     = "Jikida Rack/Rails middleware — fail-open security layer"
  s.description = "WAF, bot detection, deception. One line install. Never blocks a request when Jikida is unreachable."
  s.authors     = ["Jikida"]
  s.email       = ["info@jikida.io"]
  s.files       = ["lib/jikida.rb", "README.md"]
  s.homepage    = "https://jikida.io"
  s.license     = "MIT"
  s.required_ruby_version = ">= 3.0"
end
