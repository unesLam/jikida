{
  "manifest_version": 3,
  "name": "Website & Web App Security Scan, Malware, Firewall & Uptime — Jikida.io",
  "short_name": "Jikida Security",
  "version": "1.0.18",
  "description": "Scan any site for exposed secrets, weak headers, insecure cookies & API risks — including behind your login.",
  "author": "Jikida",
  "homepage_url": "https://jikida.io",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Jikida — open the security panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules/patterns.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
